# ============================
# .gitignore for .NET solution
# ============================

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/
artifacts/

# .NET / Visual Studio temporary files
*.dll
*.exe
*.pdb
project.lock.json
project.fragment.lock.json
*.binlog

# ASP.NET Blazor / scoped css build output
*.razor.g.cs
*.RazorAssemblyInfo.cs
scopedcss/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user

# Visual Studio / VS Code / Rider
.vs/
.vscode/
.idea/
*.iml
_ReSharper*/
*.[Rr]e[Ss]harper

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Test / coverage
[Tt]est[Rr]esult*/
*.coverage
*.coveragexml
coverage*.json
coverage*.xml

# Logs
*.log
log*.txt

# OS files
.DS_Store
Thumbs.db

# App secrets / local config
*.env
appsettings.*.local.json
