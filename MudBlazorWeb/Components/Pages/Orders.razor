@page "/orders"

<PageTitle>Orders</PageTitle>

<div class="d-flex align-center mb-4">
    <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Class="mr-2" />
    <MudText Typo="Typo.h4">Orders</MudText>
</div>

<AuthorizeView>
    <NotAuthorized>
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Orders require an admin session. Please <MudLink Href="/login">log in</MudLink>.
        </MudAlert>
    </NotAuthorized>
</AuthorizeView>

<MudTable Items="_orders" Loading="_loading" Hover="true" Bordered="true" Striped="true">
    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Customer</MudTh>
        <MudTh Style="text-align:right">Total</MudTh>
        <MudTh>Created</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Id">@context.Id</MudTd>
        <MudTd DataLabel="Customer">@(context.User?.FullName ?? $"User #{context.UserId}")</MudTd>
        <MudTd DataLabel="Total" Style="text-align:right">@context.TotalPrice.ToString("C")</MudTd>
        <MudTd DataLabel="Created">@context.CreateAt.ToLocalTime().ToString("g")</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No orders found.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>

@code {
    private List<OrderResponse> _orders = new();
    private bool _loading = true;

    [Inject] private ShopApiClient Api { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _orders = await Api.GetOrdersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load orders. {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
