@page "/"

<PageTitle>Dashboard</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Dashboard</MudText>
<MudText Class="mb-6" Color="Color.Secondary">Overview of your OnlineShop catalogue.</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column" Elevation="2" Style="height:100%">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.subtitle2" Class="mt-2">Products</MudText>
            <MudText Typo="Typo.h4">@(_loading ? "…" : _productCount.ToString())</MudText>
            <MudButton Href="/products" Variant="Variant.Text" Color="Color.Primary" Class="mt-2 align-self-start">
                Manage
            </MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column" Elevation="2" Style="height:100%">
            <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Secondary" Size="Size.Large" />
            <MudText Typo="Typo.subtitle2" Class="mt-2">Categories</MudText>
            <MudText Typo="Typo.h4">@(_loading ? "…" : _categoryCount?.ToString() ?? "—")</MudText>
            <MudButton Href="/categories" Variant="Variant.Text" Color="Color.Secondary" Class="mt-2 align-self-start">
                Manage
            </MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column" Elevation="2" Style="height:100%">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Tertiary" Size="Size.Large" />
            <MudText Typo="Typo.subtitle2" Class="mt-2">Orders</MudText>
            <MudText Typo="Typo.h4">@(_loading ? "…" : _orderCount?.ToString() ?? "—")</MudText>
            <MudButton Href="/orders" Variant="Variant.Text" Color="Color.Tertiary" Class="mt-2 align-self-start">
                View
            </MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4 d-flex flex-column" Elevation="2" Style="height:100%">
            <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Info" Size="Size.Large" />
            <MudText Typo="Typo.subtitle2" Class="mt-2">Users</MudText>
            <MudText Typo="Typo.h4">@(_loading ? "…" : _userCount?.ToString() ?? "—")</MudText>
            <MudButton Href="/users" Variant="Variant.Text" Color="Color.Info" Class="mt-2 align-self-start">
                View
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudAlert Severity="Severity.Normal" Class="mt-6">
    Entries marked "—" require an authenticated admin session.
    <MudLink Href="/login">Log in</MudLink> to load them.
</MudAlert>

@code {
    private int _productCount;
    private int? _categoryCount;
    private int? _orderCount;
    private int? _userCount;
    private bool _loading = true;

    [Inject] private ShopApiClient Api { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _productCount = (await Api.GetProductsAsync()).Count;
        }
        catch (Exception)
        {
            // API may be unreachable; leave the count at 0.
        }

        _categoryCount = await TryCount(() => Api.GetCategoriesAsync());
        _orderCount = await TryCount(() => Api.GetOrdersAsync());
        _userCount = await TryCount(() => Api.GetUsersAsync());

        _loading = false;
    }

    private static async Task<int?> TryCount<T>(Func<Task<List<T>>> loader)
    {
        try
        {
            return (await loader()).Count;
        }
        catch (Exception)
        {
            return null;
        }
    }
}
